<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/inputTitle"
            android:textColor="#212121"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/keyboard_input_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/defeatedCountText"
            android:textColor="#212121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/defeated_count_initial"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp">
        <TextView
            android:id="@+id/streakText"
            android:textColor="#212121"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/streak_initial"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/mistypeCountText"
            android:textColor="#212121"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mistype_initial"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/receivedInputText"
        android:textColor="#212121"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:maxLines="1"
        android:ellipsize="start"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/keyboard_input_empty"
        android:textSize="16sp"
        tools:text="受信文字: こんにちは" />

    <jp.ac.ritsumei.ise.phy.exp2.is0842rf.testgame.GameImeEditText
        android:id="@+id/imeInputHost"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="@android:color/transparent"
        android:importantForAccessibility="no"
        android:imeOptions="actionNone|flagNoExtractUi"
        android:inputType="text|textNoSuggestions"
        android:padding="0dp"
        android:maxLines="1"
        android:textColor="@android:color/transparent"
        android:textSize="1sp" />

    <jp.ac.ritsumei.ise.phy.exp2.is0842rf.testgame.MySurfaceView
        android:id="@+id/mySurfaceView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
